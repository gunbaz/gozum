# Copy to .env and fill in. Never commit .env.
# Leave MODEL_API_KEY empty to run in mock mode (no API calls, no charges).
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
SAM_MODEL=sam-3.1
# Force mock mode even if a key is set (1 = mock, 0 = real)
MOCK=
